@model goynote.Models.Objects.Workspace

@{
    ViewData["Title"] = "Edit";
}

<div class="container">
    <div class="row align-items-center">
        <div class="col-md-6 text-start">
            <h1>Edit Workspace</h1>
        </div>
    </div>
</div>

<hr />

<div class="container">
    <div class="row">
        <div class="col-12 col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                
                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label fw-bold"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3 form-check">
                    <input asp-for="IsPublic" class="form-check-input" type="checkbox" id="flexCheckDefault">
                    <label asp-for="IsPublic" class="form-check-label fw-bold" for="flexCheckDefault"></label>
                </div>
                
                <input type="hidden" asp-for="ID" />
                
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}