@using goynote.Models.Objects
@model goynote.Models.Objects.Project

@{
    ViewData["Title"] = "Details";
}

@functions {
    string FormatSize(int bytes) {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1048576) return $"{bytes / 1024} KB";
        return $"{bytes / 1048576.0:0.#} MB";
    }
}

<div class="container">
    <div class="row align-items-center">
        <div class="col-md-6 text-start">
            <h1>@Html.DisplayFor(model => model.Name)</h1>
            <p>@Html.DisplayFor(model => model.Description)</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-outline-light btn-sm">
               Edit
            </a>
            <a asp-controller="Notes" asp-action="CreateProjectNote" asp-route-projectId= "@Model.ID" class=" btn btn-outline-light btn-sm">
                New note
            </a>
        </div>
    </div>
</div>

<hr />

<div>
    <div class="container">
        <div class="row">
            @* rendering proj specific notes *@
            @{
                var notes = Model.PSNotes.ToList();
            }
            @if (notes.Any())
            {
                
                <div class="row">
                    @foreach (var note in notes)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card border-secondary">
                                <div class="card-body">
                                    <h5 class="card-title text-secondary">
                                        @note.Name
                                    </h5>
                                    <p class="card-text">@note.Content</p>
                                    <div class="mt-2 pt-2 border-top">
                                        @if (note.Attachments != null && note.Attachments.Any())
                                        {
                                            @foreach (var att in note.Attachments)
                                            {
                                                <div class="small text-muted d-flex justify-content-between">
                                                    <a asp-controller="Notes" asp-action="Download" asp-route-id="@att.ID" class="text-truncate me-2 link-secondary text-decoration-none">
                                                        <i class="bi bi-paperclip me-1" style="font-size: 0.9rem;"></i>@att.FileName
                                                    </a>
                                                    <span class="flex-shrink-0">@FormatSize(att.FileSize) · @att.CreatedAt.ToString("yyyy-MM-dd")</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="small text-muted fst-italic">No files attached.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>