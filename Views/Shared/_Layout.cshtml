<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Goynote</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/obsidian.css" asp-append-version="true" />
</head>
<body>
    <div class="obsidian-app">
        <aside class="sidebar p-3">
            <div class="mb-4 px-2">
                <div class="fs-5 fw-bold">Goynote</div>
            </div>
            <nav class="nav flex-column">
                <a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link" asp-controller="Workspaces">Workspaces</a>
            </nav>
        </aside>
        <div class="content-container">
            <main role="main" class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>