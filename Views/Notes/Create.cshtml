@using goynote.Models.Objects
@model goynote.Models.Objects.Note

@{
    ViewData["Title"] = "Create";
}


<div class="container">
    <form asp-action="Create" enctype="multipart/form-data">
        <input type="hidden" asp-for="WorkspaceID" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input asp-for="Name" class="note-title form-control" placeholder="Untitled note" />
        <span asp-validation-for="Name" class="text-danger d-block mb-3"></span>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="text-muted small mb-2 d-flex align-items-center">
                    <i class="bi bi-pencil-square me-2"></i>Editor
                </div>
                <textarea asp-for="Content" class="form-control note-editor" id="contentInput" rows="14" placeholder="Start writing in markdown..."></textarea>
                <span asp-validation-for="Content" class="text-danger d-block mt-2"></span>
            </div>
            <div class="col-md-6">
                <div class="text-muted small mb-2 d-flex align-items-center">
                    <i class="bi bi-eye me-2"></i>Live preview
                </div>
                <div id="livePreview" class="preview-pane"></div>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-muted small d-flex align-items-center">
                <i class="bi bi-paperclip me-2"></i>Attachment
            </label>
            <input type="file" name="file" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2 me-1"></i>Create note
            </button>
            <a asp-controller="Workspaces" asp-action="Details" asp-route-id="@Model.WorkspaceID" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/liveMarkdownPreview.js"></script>
}