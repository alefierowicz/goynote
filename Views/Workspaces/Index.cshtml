@model IEnumerable<goynote.Models.Objects.Workspace>

@{
    ViewData["Title"] = "Workspaces";
}

<div class="container">
    <div class="row align-items-center mb-4">
        <div class="col text-start">
            <h1>Workspaces</h1>
        </div>
        <div class="col text-end">
            <a asp-action="Create" class="btn btn-outline-light btn-sm">+ New workspace</a>
        </div>
    </div>
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100">
                    <a asp-action="Details" asp-route-id="@item.ID" class="stretched-link"></a>
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted small">@item.Description</p>
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a asp-action="Edit" asp-route-id="@item.ID"
                           class="btn btn-outline-secondary btn-sm position-relative" style="z-index:1">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ID"
                           class="btn btn-outline-danger btn-sm position-relative" style="z-index:1">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
