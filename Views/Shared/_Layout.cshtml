<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Goynote</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/obsidian.css" asp-append-version="true" />
</head>
<body>
    <div class="obsidian-app">
        <aside class="sidebar d-flex flex-column p-3">
            <div>
                <div class="mb-4 px-2">
                    <div class="fs-5 fw-bold">Goynote</div>
                </div>

                @{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString(); }

                <nav class="nav flex-column">
                    <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        Home
                    </a>
                    <a class="nav-link @(currentController == "Workspaces" ? "active" : "")" asp-controller="Workspaces" asp-action="Index">
                        Workspaces
                    </a>
                </nav>
            </div>

            <div class="mt-auto">
                <hr class="my-3" />
                <nav class="nav flex-column">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="nav-link text-muted small">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                        </div>

                        <form method="post" asp-controller="Account" asp-action="Logout">
                            <button type="submit" class="btn btn-outline-danger w-100 mt-2">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-light w-100 mb-2" asp-controller="Account" asp-action="Login">
                            Login
                        </a>
                        <a class="btn btn-primary w-100" asp-controller="Account" asp-action="Register">
                            Register
                        </a>
                    }
                </nav>
            </div>
        </aside>
        <div class="content-container">
            <main role="main" class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>