@using goynote.Models.Objects
@model goynote.Models.Objects.Workspace

@{
    ViewData["Title"] = "Details";
}

@functions {
    string FormatSize(int bytes) {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1048576) return $"{bytes / 1024} KB";
        return $"{bytes / 1048576.0:0.#} MB";
    }
    
    string TruncateWords(string input, int wordLimit) {
        if (string.IsNullOrWhiteSpace(input)) return input;

        var words = input.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (words.Length <= wordLimit) return input;

        return string.Join(" ", words.Take(wordLimit)) + "...";
    }
}

@if (Model == null) { return; }

<div class="container">
    <div class="row align-items-center">
        <div class="col-md-6 text-start">
            <h1>@Html.DisplayFor(model => model.Name)</h1>
            <p>@Html.DisplayFor(model => model.Description)</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-controller="Notes" asp-action="Create" asp-route-workspaceId="@Model.ID" class="btn btn-outline-light btn-sm">
                New note
            </a>
            <a asp-controller="Projects" asp-action="Create" asp-route-workspaceId="@Model.ID" class="btn btn-outline-light btn-sm">
                New project
            </a>
            <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-outline-light btn-sm">
               Edit
            </a>
        </div>
    </div>
</div>

<hr />

<div>
    <div class="container">
        <div class="row">
            @foreach (var item in Model.Projects.Where(p => p.WorkspaceID == Model.ID)) {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text">@item.Description</p>
                            <a asp-controller="Projects" asp-action="Details" asp-route-id="@item.ID" class="btn btn-primary">details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        @{ var notes = Model.Notes.ToList(); }

        @if (notes.Any()) {
            <hr />
            <div class="row">
                @foreach (var note in notes) {
                    <partial name="_NoteCard" model="note" />
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/markdownPreview.js"></script>
}