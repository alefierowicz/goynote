@using goynote.Models.Objects
@model goynote.Models.Objects.Note

@{
    ViewData["Title"] = "Details";
}

<div class="container">
    <div class="row align-items-center">
        <div class="text-start d-flex justify-content-between align-items-center">
            <h1>@Html.DisplayFor(Model => Model.Name)</h1>

            <div>
                <a asp-controller="Notes" asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-pencil-square"></i> Edit
                </a>
                <a asp-controller="Notes" asp-action="Delete" asp-route-id="@Model.ID" class="btn btn-sm btn-outline-danger ms-2">
                    <i class="bi bi-trash"></i> Delete
                </a>
                <a asp-controller="Notes" asp-action="DownloadPDF" asp-route-id="@Model.ID" class="btn btn-sm btn-outline-secondary ms-2">
                    <i class="bi bi-file-earmark-pdf"></i> Download as PDF
                </a>
                <a asp-controller="Notes" asp-action="DownloadMarkdown" asp-route-id="@Model.ID" class="btn btn-sm btn-outline-secondary ms-2">
                    <i class="bi bi-file-earmark-text"></i> Download as Markdown
                </a>
            </div>
        </div>
        <div class="mt-2 mb-4 border-bottom"></div>
        <div class="markdownContent">@Html.DisplayFor(Model => Model.Content)</div>
    </div>

    <div class="mt-2 pt-2 border-top">
        @if (Model.Attachments != null && Model.Attachments.Any())
        {
            @foreach (var att in Model.Attachments)
            {
                <div class="small text-muted d-flex justify-content-between">
                    <a asp-controller="Notes" asp-action="Download" asp-route-id="@att.ID" class="text-truncate me-2 link-secondary text-decoration-none">
                        <i class="bi bi-paperclip me-1" style="font-size: 0.9rem;"></i>@att.FileName
                    </a>
                    <span class="flex-shrink-0">@ViewHelpers.FormatSize(att.FileSize) · @att.CreatedAt.ToString("yyyy-MM-dd")</span>
                </div>
            }
        }
        else
        {
            <div class="small text-muted fst-italic">No files attached.</div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/markdownPreview.js"></script>
}