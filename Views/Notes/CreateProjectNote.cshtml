@using goynote.Models.Objects
@model goynote.Models.Objects.ProjectSpecificNote

@{
    ViewData["Title"] = "Create note";
}

<div class="container">
    <div class="row align-items-center">
        <div class="col-md-6 text-start">
            <h1>Create note</h1>
        </div>
    </div>
</div>

<hr />

<div class="container">
    <div class="row">
        <div class="col-12">
            <form asp-action="CreateProjectNote" enctype="multipart/form-data">
                <input type="hidden" asp-for="WorkspaceID" />
                <input type="hidden" asp-for="ProjectID" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="form-group mb-3 w-50 text-center">
                        <label asp-for="Content" class="control-label fw-bold"></label>
                        <textarea asp-for="Content" class="form-control" id="contentInput"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                    <div class="w-50 ps-3">
                        <p class="fw-bold text-center">Live preview</p>
                        <div id="livePreview"></div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold">Attachment</label>
                    <input type="file" name="file" class="form-control" />
                </div>

                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/liveMarkdownPreview.js"></script>
}
