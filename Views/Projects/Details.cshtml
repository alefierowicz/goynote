@using goynote.Models.Objects
@model goynote.Models.Objects.Project

@{
    ViewData["Title"] = "Details";
}

<div class="container">
    <div class="row align-items-center">
        <div class="col-md-6 text-start">
            <h1>@Html.DisplayFor(model => model.Name)</h1>
            <p>@Html.DisplayFor(model => model.Description)</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-outline-light btn-sm">
               Edit
            </a>
            <a asp-controller="Notes" asp-action="CreateProjectNote" asp-route-projectId= "@Model.ID" class=" btn btn-outline-light btn-sm">
                New note
            </a>
        </div>
    </div>
</div>

<hr />

<div>
    <div class="container">
        <div class="row">
            @* rendering proj specific notes *@
            @{
                var notes = Model.PSNotes.ToList();
            }
            @if (notes.Any())
            {
                
                <div class="row">
                    @foreach (var note in notes){
                        <partial name="_NoteCard" model="note" />
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/markdownPreview.js"></script>
}